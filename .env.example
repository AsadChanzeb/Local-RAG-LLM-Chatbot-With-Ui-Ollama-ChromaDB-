# ============================================================
# Local RAG LLM Chatbot Configuration
# ============================================================

# (Optional) Custom Ollama Base URL (defaults to http://127.0.0.1:11434)
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# (Optional) Google Gemini API Key (only needed if using Gemini models)
# GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) xAI Grok API Key (only needed if using Grok models)
# GROK_API_KEY=your_grok_api_key_here
